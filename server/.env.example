# Connexion PostgreSQL (valeurs du docker-compose.yml)
DATABASE_URL=postgres://lamarelle:MOT_DE_PASSE@localhost:5435/lamarelle

# Mettre "true" pour une base hébergée en ligne (Neon, Render, Supabase…)
DATABASE_SSL=false

# Clé secrète pour les jetons de connexion : mettre une longue chaîne aléatoire
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# 3002 pour ne pas entrer en conflit avec d'autres projets (3000, 3001)
PORT=3002
